#!/usr/bin/env bash
# veo-gen — gflow video 薄封装(motion-explainer 副本,源自 skills/flow-media)
# =============================================================================
# 与 flow-media 版的差异,改动时两边都要同步:
#   a) GFLOW_CLI_PREFER_CLASSIC=1 → GFLOW_CLI_UI_MODE=classic(前者在 gflow
#      0.44 已废弃并打 DeprecationWarning;可用 GFLOW_UI_MODE 覆盖)
#   b) attempts.log 写到运行目录($PWD,即本次视频的 run 目录),不再写进 skill
#      仓库。用 VEO_GEN_LOG 覆盖路径。
#
# 固化本机 Flow Ultra 账号的已知规律:
#   1) 账号被灰度到 Flow 新版 agentic UI → 必须 GFLOW_CLI_UI_MODE=classic,
#      否则在"新建 project"步就 RuntimeError。视频侧的 MCP 工具没有 ui_mode
#      参数,所以走 MCP 时这个开关只能在 MCP server 注册的 env 里设。
#   2) 只对「提交前的瞬时错误」自动重试(HTTP 503 / UI 抖动 / 浏览器会话断)——
#      这些发生在模型跑起来之前,不扣订阅额度,重试安全。
#   3) 「提交后失败」(请求已被后端接受、模型已跑,MEDIA_GENERATION_STATUS_FAILED)
#      很可能已扣额度 → 绝不自动重试,直接停下报告,避免空烧。
#
# 成功判据:gflow 自身退出码 == 0(权威),再从 --json 结果取产物路径。
#
# 用法:
#   veo-gen [--retries N] [--final PATH] [--base-delay S] [--max-delay S] \
#           -- <传给 `gflow video` 的原始参数...>
#
# 例(EP07 V01 首尾帧补间,成功后重命名为 V01-final.mp4):
#   veo-gen --final asset/veo/V01-final.mp4 -- \
#     i2v --initial-frame asset/veo/V01-start.png --end-frame asset/veo/V01-end.png \
#         --aspect 16:9 --model veo-lite --duration 4 --out-dir asset/veo \
#         "slow cinematic pan right across the base at dusk"
#
# `--` 之后一切原样透传给 `gflow video`,任何 gflow 新参数自动可用。
# =============================================================================
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

RETRIES=6            # 最大尝试次数(仅对提交前瞬时错误生效)
FINAL=""            # 成功后把产物移动到此路径(可选)
BASE_DELAY=4         # 退避基数(秒)
MAX_DELAY=30         # 单次退避上限(秒)
UI_MODE="${GFLOW_UI_MODE:-classic}"   # 本机账号被灰度到 agentic UI,视频必须走 classic
WANT_HAR=0           # --har:抓完整网络流量。崩在下载环节时,HAR 里能找回产物 URL
HAR_FILE=""

die() { printf '\033[31m[veo-gen] %s\033[0m\n' "$*" >&2; exit 1; }
info() { printf '\033[36m[veo-gen] %s\033[0m\n' "$*" >&2; }
ok()   { printf '\033[32m[veo-gen] %s\033[0m\n' "$*" >&2; }

# ---- 解析封装自身参数(遇 `--` 或首个未知 token 即停)------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    --retries)    RETRIES="$2"; shift 2 ;;
    --final)      FINAL="$2";   shift 2 ;;
    --base-delay) BASE_DELAY="$2"; shift 2 ;;
    --max-delay)  MAX_DELAY="$2";  shift 2 ;;
    --har)        WANT_HAR=1;      shift 1 ;;
    --)           shift; break ;;
    -h|--help)    sed -n '2,32p' "$0"; exit 0 ;;
    *)            break ;;
  esac
done

[ $# -gt 0 ] || die "缺少 gflow video 参数。用法见 veo-gen --help"

GARGS=("$@")
case " ${GARGS[*]} " in *" --json "*) ;; *) GARGS+=(--json) ;; esac
# 通用:GFLOW_PROJECT 环境变量 → 追加 --project(项目内复用素材/媒体库不碎片化)。
# 项目 id 怎么来是调用方(各仓库本地约定)的事,本封装不做仓库探测。
if [ -n "${GFLOW_PROJECT:-}" ]; then
  case " ${GARGS[*]} " in *" --project "*) ;; *) GARGS+=(--project "$GFLOW_PROJECT") ;; esac
fi

command -v gflow >/dev/null 2>&1 || die "找不到 gflow,请确认已 uv tool install gflow-cli 且 ~/.local/bin 在 PATH"

# ---- 提交前瞬时错误类(仅这些在「未提交」时重试)----------------------------
# 与 gflow 自己的 errors.is_retryable 对齐。加 FlowAppError / RateLimitError /
# NetworkError 是 2026-07-27 实测补的:FlowAppError(exit 31)被 gflow 标为
# retryable,但原白名单(继承自 flow-media)没有它,于是一次瞬时的 Flow 应用层
# 抖动就被当成终端错误放弃了 —— 明明 submitted=false、一分钱没扣。
#
# 加进来是安全的:上面的 generate_captured 信用取证在前面把关,只要请求已提交
# 就一律不重试。这个白名单只管「提交前」的失败,而那些按定义不扣额度。
TRANSIENT_RE='^(WireFormatError|UnexpectedError|TransportTimeoutError|TransportError|WafRejectionError|FlowAgentUiError|FlowAppError|RateLimitError|NetworkError|BrowserSessionClosedError|BrowserEngineUnavailableError)$'

TMP="$(mktemp -d "${TMPDIR:-/tmp}/veo-gen.XXXXXX")"
OUT_JSON="$TMP/out.json"; ERR_LOG="$TMP/err.log"

# 失败时保留完整诊断。原来这里是无条件 rm -rf,结果一次花了钱的失败,
# 完整 stderr 被自动删掉,只剩终端上 tail 的四行(实测 2026-07-27)。
# 付费操作的失败证据不能靠 tail。
DIAG_DIR="${VEO_GEN_DIAG:-$PWD/veo-gen-diag}"
cleanup() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -d "$TMP" ]; then
    local dest="$DIAG_DIR/$(date +%Y%m%dT%H%M%S)-exit${rc}"
    if mkdir -p "$dest" 2>/dev/null; then
      cp -f "$OUT_JSON" "$ERR_LOG" "$dest/" 2>/dev/null || true
      [ -n "${HAR_FILE:-}" ] && [ -f "$HAR_FILE" ] && mv -f "$HAR_FILE" "$dest/" 2>/dev/null
      printf '\033[33m[veo-gen] 完整诊断已保留 → %s\033[0m\n' "$dest" >&2
      [ -n "${HAR_FILE:-}" ] && printf '\033[33m[veo-gen] HAR 含 auth cookie,勿外传;里面能找到产物的签名 URL\033[0m\n' >&2
    fi
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT

# 从 --json 结果对象(排除带 event 键的日志行)取 status|class|local_path。
# 只认「无 event 键」且含 status/succeeded/command 的对象 = 真正的结果对象。
extract_result() {
python3 - "$OUT_JSON" <<'PY'
import json, sys
try:
    text = open(sys.argv[1], encoding="utf-8", errors="replace").read()
except OSError:
    print("||"); sys.exit(0)
dec = json.JSONDecoder(); best = None; i = 0; n = len(text)
while i < n:
    if text[i] == '{':
        try:
            obj, end = dec.raw_decode(text, i)
            if isinstance(obj, dict) and "event" not in obj and (
                "status" in obj or "succeeded" in obj or "command" in obj):
                best = obj
            i = end; continue
        except json.JSONDecodeError:
            pass
    i += 1
if not best:
    print("||"); sys.exit(0)
status = best.get("status", "")
cls = ""
err = best.get("error")
if isinstance(err, dict):
    cls = err.get("class") or err.get("title") or ""
lp = best.get("local_path") or ""
if not lp:
    for k in ("local_paths", "results"):
        v = best.get(k)
        if isinstance(v, list) and v:
            f = v[0]; lp = f.get("local_path","") if isinstance(f, dict) else str(f); break
print(f"{status}|{cls}|{lp}")
PY
}

# 兜底:从日志里最后一个 video_saved 事件取 path
fallback_path() {
  grep -o '"path": "[^"]*\.mp4"' "$ERR_LOG" 2>/dev/null | tail -1 | sed 's/"path": "//; s/"$//'
}

finish_success() {  # $1 = local_path
  local lpath="$1"
  if [ -n "$FINAL" ] && [ -n "$lpath" ] && [ -f "$lpath" ]; then
    mkdir -p "$(dirname "$FINAL")"; mv -f "$lpath" "$FINAL"; ok "已重命名 → $FINAL"; lpath="$FINAL"
  fi
  cat "$OUT_JSON" 2>/dev/null
  [ -n "$lpath" ] && printf '\n%s\n' "$lpath"
  exit 0
}

# ---- 重试主循环 -------------------------------------------------------------
attempt=0
auth_retried=0   # 认证失效只兜一次(SSO 静默重铸,见下)
while :; do
  attempt=$((attempt+1))
  # DEBUG_TRACEBACK:让未捕获的裸 Error 打出真实消息与 traceback,而不是哈希占位符。
  # 上次那个 phase=video_generation 的 Error 就是被哈希掉了,查不出所以然。
  ENVV=(GFLOW_CLI_UI_MODE="$UI_MODE" GFLOW_CLI_DEBUG_TRACEBACK="${GFLOW_DEBUG_TB:-1}")
  if [ "$WANT_HAR" -eq 1 ]; then
    HAR_FILE="$TMP/session-${attempt}.har"
    ENVV+=(GFLOW_CLI_HAR_PATH="$HAR_FILE")
  fi
  info "尝试 $attempt/$RETRIES: gflow video ${GARGS[*]}"
  env "${ENVV[@]}" gflow video "${GARGS[@]}" >"$OUT_JSON" 2>"$ERR_LOG"
  gec=$?

  IFS='|' read -r status cls lpath < <(extract_result)
  [ -z "$lpath" ] && lpath="$(fallback_path)"

  # 病历本:每次尝试落一行(时间|第几次|退出码|错误类|是否已提交|参数摘要)——"为什么老重试"从此拿数据回答
  ATT_LOG="${VEO_GEN_LOG:-$PWD/veo-gen-attempts.log}"
  _sub=false; grep -q 'generate_captured' "$ERR_LOG" 2>/dev/null && _sub=true
  # media_id/project_id 也记下来:崩在下载环节时,这两个是到 Flow 网页手动
  # 找回产物的唯一线索,而它们只存在于那次运行的 stderr 里。
  _mid="$(grep -o '"media_name": "[^"]*"' "$ERR_LOG" 2>/dev/null | tail -1 | sed 's/.*: "//; s/"$//')"
  _pid="$(grep -o '"project_id": "[^"]*"' "$ERR_LOG" 2>/dev/null | tail -1 | sed 's/.*: "//; s/"$//')"
  printf '%s|attempt=%s|exit=%s|class=%s|submitted=%s|media=%s|project=%s|gflow=%s|args=%.80s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$attempt" "$gec" "${cls:-none}" "$_sub" \
    "${_mid:-none}" "${_pid:-none}" \
    "$(gflow --version 2>/dev/null | grep -o '[0-9.]*$')" "${GARGS[*]}" >> "$ATT_LOG" 2>/dev/null || true

  # 【第一判据】gflow 退出码 0 = 成功,一锤定音
  if [ "$gec" -eq 0 ] || [ "$status" = "ok" ]; then
    ok "成功(第 $attempt 次)。产物: ${lpath:-<见 --out-dir>}"
    finish_success "$lpath"
  fi

  # 失败:先判断请求是否已被后端接受(模型是否已跑 = 是否可能已扣额度)
  submitted=false
  grep -q 'generate_captured' "$ERR_LOG" 2>/dev/null && submitted=true

  cls_show="${cls:-<未知>}"
  if [ "$submitted" = true ]; then
    # 提交后失败:已扣额度 → 一律不重试。但要分两种,处置完全不同。
    if grep -q 'MEDIA_GENERATION_STATUS_SUCCESSFUL' "$ERR_LOG" 2>/dev/null; then
      # 生成其实成功了,是取回产物那一步崩的(实测 2026-07-27:
      # poll_terminal 报 SUCCESSFUL,随后 phase=video_generation 抛裸 Error)。
      # 片子在 Flow 项目里是好的,只是没下载下来 —— 千万别当成内容策略问题重跑。
      mid="$(grep -o '"media_name": "[^"]*"' "$ERR_LOG" | tail -1 | sed 's/.*: "//; s/"$//')"
      pid="$(grep -o '"project_id": "[^"]*"' "$ERR_LOG" | tail -1 | sed 's/.*: "//; s/"$//')"
      info "⚠ 生成成功但产物没取回来(额度已扣)。片子还在 Flow 项目里:"
      printf '\033[33m    media_id   %s\n    project_id %s\033[0m\n' "${mid:-<见日志>}" "${pid:-<见日志>}" >&2
      die "取回失败(exit=$gec, 错误类=$cls_show)。gflow 没有「下载已有 media」的命令 ——
  到 Flow 网页里打开该项目手动下载,或确认要再花一个额度才重跑。
  别改 prompt:生成本身是好的。"
    fi
    info "请求已被后端接受但生成失败(可能已扣额度),不自动重试。尾部日志:"
    tail -4 "$ERR_LOG" >&2 || true
    die "提交后失败(exit=$gec, 错误类=$cls_show)。请检查 prompt/帧是否触发内容策略或模型异常;需要时手动重跑。"
  fi

  # 提交前失败:仅对「明确的瞬时错误类」重试(不扣额度)。
  # 未知/空错误类不重试——避免像内容策略/参数/用法错误那样被反复空转。
  if [[ "$cls" =~ $TRANSIENT_RE ]]; then
    if [ "$attempt" -ge "$RETRIES" ]; then
      die "已达最大重试次数 $RETRIES,最后错误: $cls_show(exit=$gec)。可能 Flow 后端持续不可用或 UI 变体锁死,稍后再试或跟进 issue #174。"
    fi
    delay=$(( BASE_DELAY * attempt + RANDOM % 4 )); [ "$delay" -gt "$MAX_DELAY" ] && delay="$MAX_DELAY"
    info "提交前瞬时错误 $cls_show(exit=$gec)→ ${delay}s 后重试(不扣额度)"
    sleep "$delay"; continue
  fi

  # 认证失效(提交前,不扣额度):SSO 静默重铸兜底(2026-07-24)——
  # profile 登录 SOP 补了 google.com SID 后,NextAuth session 过期时 labs.google 的
  # OAuth 跳转会经 accounts.google.com 静默重铸新 session(首次撞 401 的那次访问往往已完成重铸落盘)。
  # 故认证类失败立即重试一次即可通过;只兜一次——第二次仍失败=SSO 层也没了,须人工 gflow auth login。
  if [ "$auth_retried" -eq 0 ] && { [[ "${cls:-}" == *Auth* ]] || grep -qi 'AuthExpired\|auth login' "$ERR_LOG" 2>/dev/null; }; then
    auth_retried=1
    info "认证失效(提交前,不扣额度)→ 8s 后重试一次(赌 profile 内 SID 已静默重铸 session;再失败=需人工重登)"
    sleep 8; continue
  fi

  # 终端错误(内容策略/认证二连败/参数/未知等):立即停止,不空转
  info "终端/未知错误 $cls_show(exit=$gec),不重试。尾部日志与结果:"
  tail -4 "$ERR_LOG" >&2 || true; cat "$OUT_JSON" >&2
  exit "$gec"
done
